{
  "name": "streetcred",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "workspaces": [
    "packages/*",
    "frontend"
  ],
  "scripts": {
    "dev": "turbo dev --parallel",
    "lint": "turbo lint",
    "test": "turbo test",
    "db:migrate": "bash -c 'psql \"${DATABASE_URL?}\" -f scripts/migrate.sql'"
  },
  "devDependencies": {
    "nodemon": "^3.1.1",
    "turbo": "^2.5.4"
  },
  "engines": { "node": ">=20.0.0" }
}
